# Build
bin/
obj/
[Bb]uild/
[Oo]ut/
# Python bytecode/cache (global; research/optionflow also has its own rules)
__pycache__/
*.pyc
*.pyo
artifacts/*
!artifacts/.gitkeep
!artifacts/build/
!artifacts/build/**

# IDE / OS
.vs/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db

# Logs / local runtime
*.log
!artifacts/build/*.log
*.spool
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets
.env
*.pfx
credentials*.json
rithmic.env
rithmic*.env

# OptionFlow sidecar (research/optionflow)
research/optionflow/.venv/
research/optionflow/**/__pycache__/
research/optionflow/**/*.pyc
research/optionflow/.pytest_cache/
research/optionflow/tests/fixtures/*.json
!research/optionflow/tests/fixtures/.gitkeep
# published option levels are runtime output, not source
artifacts/optionflow/
