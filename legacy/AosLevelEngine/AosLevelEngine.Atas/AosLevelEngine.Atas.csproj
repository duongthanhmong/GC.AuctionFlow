<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Aos.LevelEngine.Atas</RootNamespace>
    <AssemblyName>AosLevelEngine.Atas</AssemblyName>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      CẦN XÁC MINH TRÊN ATAS THẬT if install path differs.
      Override: dotnet build -p:AtasIndicatorsPath="..."
    -->
    <AtasIndicatorsPath Condition="'$(AtasIndicatorsPath)' == ''">C:\Program Files (x86)\ATAS Platform\ATAS.Indicators.dll</AtasIndicatorsPath>
    <AtasDataFeedsPath Condition="'$(AtasDataFeedsPath)' == ''">C:\Program Files (x86)\ATAS Platform\ATAS.DataFeedsCore.dll</AtasDataFeedsPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasIndicatorsPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(AtasDataFeedsPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AosLevelEngine.csproj" />
  </ItemGroup>

</Project>
